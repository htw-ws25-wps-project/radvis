<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.10.xsd">

    <changeSet author="Sophia Lehmann" id="RAD-PHOTO-001">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="report_photo"/>
            </not>
        </preConditions>
        <createTable tableName="report_photo">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="report_photo_pkey"/>
            </column>
            <column name="data" type="BLOB">
                <constraints nullable="false"/>
            </column>
            <column name="filename" type="VARCHAR(255)"/>
            <column name="content_type" type="VARCHAR(100)"/>
            <column name="size" type="BIGINT"/>
            <column name="report_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="report_photo"
                                 baseColumnNames="report_id"
                                 constraintName="fk_report_photo_report"
                                 referencedTableName="report"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>